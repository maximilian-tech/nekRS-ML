#if 1
void put_wallModel_data(
        std::vector<dfloat> wall_shear_stress, 
        std::vector<dlong> BdryToV, 
        std::vector<dfloat> Upart,
        int tstep)
{
  int _num_inputs = 1, _num_outputs=1;
  int _num_samples = npts_;
  unsigned long int num_cols = _num_inputs+_num_outputs; // 1 + 1
  //std::string key = "x." + std::to_string(_rank) + "." + std::to_string(tstep);
  
  std::vector<dfloat> train_data(_num_samples*num_cols); // _num_samples=npts
  std::vector<dfloat> vel_data(_num_samples);
  std::vector<dfloat> shear_data(_num_samples);

  // Extract velocity at off-wall nodes (inputs) and shear at wall nodes (outputs)
  dfloat avg_utau = 0.0;
  dfloat avg_ut   = 0.0;
  for (int n = 0; n < _num_samples; ++n) {
    const int v = BdryToV[n];
    vel_data[n] = Upart[0*_num_samples + n];
    avg_ut += vel_data[n];
    shear_data[n] = wall_shear_stress[v+0*nrs->fieldOffset];
    avg_utau += shear_data[n];
  }
  int rank = -1;
  MPI_Comm_rank(platform->comm.mpiComm, &rank);
  if (rank == 0)
    printf("\nTrain :: AVG -- UTAU UT :: %g %g \n",sqrt(abs(avg_utau/_num_samples)),avg_ut/_num_samples);

  // Concatenate inputs and outputs
  for (int i=0; i<_num_samples; i++) {
    train_data[i*num_cols] = vel_data[i];
    train_data[i*num_cols+1] = shear_data[i];
  }
  std::string key = "";
  // _client->put_tensor(key, train_data.data(), {_num_samples,num_cols},
  //                   SRTensorTypeDouble, SRMemLayoutContiguous);
  int64_t shape[2] = {_num_samples, num_cols};
  rdq_dl_desc_t d = {
            .data = train_data.data(),
            .nbytes = train_data.size() * sizeof(train_data[0]),
            .ndim = 2,
            .shape = shape,
            .strides = NULL,
            .device_type = kDLCPU,
            .device_id = 0,
            .dtype_code = kDLFloat,
            .dtype_bits = 64,
            .dtype_lanes = 1,
            .byte_offset = 0
        };
  int target = 0;
  RDQ_ASSERT(rdq_send_dl(ctx, target, &d) == RDQ_OK);
}
#endif

void UDF_ExecuteStep(dfloat time, int tstep)
{
  //int verbose = (tstep % 10 == 0) ? 1 : 0;
  int verbose = 0;
  tavg::run(time);

  // Send training data for model every set number of steps
  if (tstep%1==0 && tstep>0) {
    auto o_avg = tavg::o_avg();
    calcTauWall(nrs, time, tstep, o_avg); //calculates shear stress in volume
    updateRecycledVelocity(nrs, o_avg, verbose); //interpolates velocity on off-wall nodes
    o_Upart.copyTo(Upart); //copy from occa mem to CPU mem
#ifdef SMARTREDIS
    client->put_wallModel_data(usrwrk, BdryToV, Upart, tstep);
#else
    put_wallModel_data(usrwrk, BdryToV, Upart, tstep);
#endif
    MPI_Barrier(platform->comm.mpiComm);
#ifdef SMARTREDIS
    client->put_step_num(tstep);
#endif
    if (platform->comm.mpiRank == 0)
      std::cout << "All ranks finished sending training data for step " << tstep << std::endl;
  }

  if (tstep > 1 && (tstep % tAvgWriteInterval)==0) {
     writeStatistics(nrs, time, tstep, "NekAvgData_1D.csv");
  }
  if (nrs->lastStep) {
  int shard=0;
  std::cout << "Begin unregister: Step " << tstep << std::endl;
  RDQ_ASSERT(rdq_unregister_producer(ctx, shard) == RDQ_OK);
  std::cout << "End unregister: Step " << tstep << std::endl;
  }
  // Every time step check if ML training says it is time to quit
#ifdef SMARTREDIS
  int exit_val = client->check_run();
  if (exit_val==0) {
    nekrs::setEndTime(-10.0);
    nekrs::forceLastStep();
  }
#endif
}

void UDF_Finalize()
{
  
    rdq_close(ctx);
    std::cout << "finalize!!!!!" << std::endl;
}
